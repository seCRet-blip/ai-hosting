# API Security Configuration
# Copy this file to .env and set your own values

# API Key for authentication (CHANGE THIS!)
AI_API_KEY=your-secret-api-key-change-this-to-something-secure

# ngrok authentication token
# Get your token from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your-ngrok-auth-token-here

# Public or local API base URL used by test.js (no trailing slash)
AI_API_URL=http://localhost

# Example of how to generate a secure API key:
# In Python: import secrets; print(secrets.token_urlsafe(32))
# In PowerShell: [System.Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
